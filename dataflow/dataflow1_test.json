{
	"name": "dataflow1_test",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_df_source",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sqlDBDataset",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          employee_id as string,",
				"          employee_name as string,",
				"          department_id as string,",
				"          gross_salary as decimal(10,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(base_salary = gross_salary * 0.60,",
				"          tds = (gross_salary * 0.60 ) * 0.10,",
				"          employee_id = toInteger(employee_id),",
				"          department_id = toInteger(department_id)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          employee_id as integer,",
				"          employee_name as string,",
				"          department_id as integer,",
				"          gross_salary as decimal(10,2),",
				"          base_salary as decimal(10,2),",
				"          tds as decimal(10,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          employee_id,",
				"          employee_name,",
				"          department_id,",
				"          gross_salary,",
				"          base_salary,",
				"          tds",
				"     )) ~> sink1"
			]
		}
	}
}