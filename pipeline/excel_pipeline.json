{
	"name": "excel_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Get file list",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_Sales_Folder",
						"type": "DatasetReference",
						"parameters": {
							"ds_p_folder_path": "raw/sales"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get file list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_file_count",
					"value": {
						"value": "@length(activity('Get file list').output.childItems)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check Files Available",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(int(variables('v_file_count')), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Set Sheet List",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_sheet_list",
								"value": [
									"@createArray('Bangalore','Mumbai','Delhi','Hyderabad')"
								]
							}
						}
					]
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Check Files Available",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@createArray('Bangalore','Mumbai','Delhi','Hyderabad')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ExcelSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "Excel1",
									"type": "DatasetReference",
									"parameters": {
										"ds_p_folder_path": "raw/sales",
										"ds_p_file_name": "sales_2026_09_09.xlsx",
										"ds_p_sheet_name": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Sales_Output",
									"type": "DatasetReference",
									"parameters": {
										"ds_p_output_folder": {
											"value": "@concat('staging/sales/', item(), '/')",
											"type": "Expression"
										},
										"ds_p_output_file": {
											"value": "@concat(item(), '_sales.csv')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"p_folder_path": {
				"type": "string",
				"defaultValue": "raw/sales/"
			},
			"p_file_name": {
				"type": "string",
				"defaultValue": "sales_2026_09_09.xlsx"
			}
		},
		"variables": {
			"v_file_count": {
				"type": "Integer"
			},
			"v_sheet_list": {
				"type": "Array"
			},
			"Set File Count": {
				"type": "Integer"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-09T16:45:57Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}